# ── App ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api

# ── MongoDB Atlas ───────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/aajjo_scraper?retryWrites=true&w=majority

# ── Redis (BullMQ) ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── AWS S3 + CloudFront ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=eb2bmart-dev-bucket
CLOUDFRONT_DOMAIN=            # e.g. d1abc123.cloudfront.net (no https://)
S3_IMAGE_PREFIX=images

# ── Authentication ──────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=change-me-in-production
REFRESH_TOKEN_EXPIRY=7d

# ── Scraping ────────────────────────────────────────────────────
MAX_CONCURRENT_BROWSERS=5
WORKER_CONCURRENCY=5
PROXY_SERVICE_URL=
PROXY_API_KEY=
REQUEST_DELAY_MIN_MS=2000
REQUEST_DELAY_MAX_MS=5000
SCRAPER_TIMEOUT_MS=30000

# ── Export ──────────────────────────────────────────────────────
EXPORT_DOWNLOAD_EXPIRY_HOURS=48
EXPORT_STORAGE_PATH=/tmp/exports

# ── Monitoring ──────────────────────────────────────────────────
LOG_LEVEL=debug
SENTRY_DSN=
SLACK_WEBHOOK_URL=
